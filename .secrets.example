# Скопируй этот файл в `.secrets` (git-ignored) и заполни реальными
# значениями. Используется:
#   - tests/integration/  — интеграционные тесты на реальном Telegram;
#   - scripts/tg_login.py — одноразовая интерактивная авторизация
#     (создаёт session-файл).
#
# api_id / api_hash: https://my.telegram.org → API development tools.

TG_API_ID=12345
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+79991234567

# Путь к session-файлу Telethon (без расширения), относительно корня
# проекта. Каталог sessions/ в .gitignore — session-файл это полноценные
# учётные данные аккаунта, никогда не коммитить.
TG_SESSION=sessions/integration

# Две тестовые группы. Рекомендуются супергруппы (id вида -100...) —
# целевой кейс библиотеки (§9.4 ТЗ). id подскажет scripts/tg_login.py
# после авторизации (выводит список доступных групп).
TG_TEST_GROUP_A=-1001111111111
TG_TEST_GROUP_B=-1002222222222
