# Скопируй этот файл в `.secrets` (git-ignored) и заполни реальными
# значениями. Используется:
#   - tests/integration/  — интеграционные тесты на реальном Telegram;
#   - scripts/tg_login.py — одноразовая интерактивная авторизация
#     (создаёт session-файл).
#
# api_id / api_hash: https://my.telegram.org → API development tools.

TG_API_ID=12345
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+79991234567

# Путь к session-файлу Telethon (без расширения), относительно корня
# проекта. Каталог sessions/ в .gitignore — session-файл это полноценные
# учётные данные аккаунта, никогда не коммитить.
TG_SESSION=sessions/integration

# Три тестовые группы. Рекомендуются супергруппы (id вида -100...) —
# целевой кейс библиотеки (§9.4 ТЗ). id подскажет scripts/tg_login.py
# после авторизации (выводит список доступных групп).
#
# Роли в контуре §13.2: A — источник, B и C — цели multicast (вариант 1,
# чистый fan-out без петель). Вариант 2 (петлевой guard) использует
# A одновременно как источник и цель.
TG_TEST_GROUP_A=-1001111111111
TG_TEST_GROUP_B=-1002222222222
TG_TEST_GROUP_C=-1003333333333

# --- Ручной триггер (T038, examples/trigger) ---
# API-ключ HTTP-ручек ручного триггера (POST /api/v1/trigger и
# /api/v1/run/{pipeline}). Секрет: подаётся как есть в окружение
# (example_dev.sh экспортирует ANGARION_*-переменные из .secrets).
# Пусто/не задан → ручки триггера выключены (запрос → 503); examples/trigger
# подставляет demo-значение, если переменная не задана. Сгенерировать свой:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ANGARION_API__TRIGGER_TOKEN=replace-me-with-a-random-secret

# --- Matrix-контур (M7 B4): локальный homeserver ---
# Стенд поднимается локально (docker compose или Synapse из PyPI) —
# см. tests/integration/matrix/README.md. Тест создаёт комнаты сам,
# нужны только адрес homeserver'а и реквизиты аккаунта.
MATRIX_HOMESERVER=http://localhost:8008
MATRIX_USER=@bot:localhost
MATRIX_PASSWORD=botpass123

# --- Публикация на PyPI (scripts/publish.sh, T012) ---
# Токены создаются на:
#   - PyPI:     https://pypi.org/manage/account/token/
#   - TestPyPI: https://test.pypi.org/manage/account/token/  (опционально)
#
# Для проекта angarion используем project-scoped токен (scope «Project:
# angarion»). Первая публикация требует account-scoped токена — после
# неё переключаемся на project-scoped (безопаснее: токен не даёт доступа
# к другим проектам аккаунта).
PYPI_TOKEN=pypi-REPLACE-ME

# Опционально — только если публикуем и в TestPyPI (scripts/publish.sh --test).
PYPI_TEST_TOKEN=pypi-REPLACE-ME
